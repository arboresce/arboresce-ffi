{
  "schema": 1,
  "platforms": {
    "macos-arm64": {
      "rust": "aarch64-apple-darwin",
      "os": "darwin",
      "cpu": "arm64",
      "native_minimum": "macOS 11.0"
    },
    "macos-x64": {
      "rust": "x86_64-apple-darwin",
      "os": "darwin",
      "cpu": "x64",
      "native_minimum": "macOS 11.0"
    },
    "linux-arm64": {
      "rust": "aarch64-unknown-linux-gnu",
      "os": "linux",
      "cpu": "arm64",
      "libc": "glibc",
      "native_minimum": "glibc 2.17"
    },
    "linux-x64": {
      "rust": "x86_64-unknown-linux-gnu",
      "os": "linux",
      "cpu": "x64",
      "libc": "glibc",
      "native_minimum": "glibc 2.17"
    },
    "windows-x64": {
      "rust": "x86_64-pc-windows-msvc",
      "os": "win32",
      "cpu": "x64",
      "native_minimum": "Windows 10"
    },
    "ios-arm64": {
      "rust": "aarch64-apple-ios",
      "native_minimum": "iOS 13.0"
    },
    "ios-sim-arm64": {
      "rust": "aarch64-apple-ios-sim",
      "native_minimum": "iOS 13.0"
    },
    "ios-sim-x64": {
      "rust": "x86_64-apple-ios",
      "native_minimum": "iOS 13.0"
    },
    "android-arm64": {
      "rust": "aarch64-linux-android",
      "abi": "arm64-v8a",
      "native_minimum": "Android API 28"
    },
    "android-armv7": {
      "rust": "armv7-linux-androideabi",
      "abi": "armeabi-v7a",
      "native_minimum": "Android API 28"
    },
    "android-x64": {
      "rust": "x86_64-linux-android",
      "abi": "x86_64",
      "native_minimum": "Android API 28"
    },
    "browser": {
      "rust": "wasm32-unknown-unknown",
      "native_minimum": "WebAssembly and ES2022"
    }
  },
  "languages": {
    "python": {
      "runtime": "Python >=3.14",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "planned",
          "effective_minimum": "macOS 11.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "windows-x64": {
          "intent": "planned",
          "effective_minimum": "Windows 10"
        }
      }
    },
    "typescript": {
      "runtime": "Node >=22.22.3; browser ES2022",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.28; kernel 4.18"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.28; kernel 4.18"
        },
        "windows-x64": {
          "intent": "planned",
          "effective_minimum": "Windows 10"
        },
        "browser": {
          "intent": "runtime",
          "effective_minimum": "WebAssembly and ES2022"
        }
      }
    },
    "kotlin": {
      "runtime": "Java 8 bytecode; Java 8/21 Linux and JDK 21 macOS runtime test targets",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "link",
          "effective_minimum": "macOS 11.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "windows-x64": {
          "intent": "planned",
          "effective_minimum": "Windows 10"
        }
      }
    },
    "android": {
      "runtime": "Android API >=28",
      "targets": {
        "android-arm64": {
          "intent": "runtime",
          "effective_minimum": "Android API 28"
        },
        "android-armv7": {
          "intent": "link",
          "effective_minimum": "Android API 28"
        },
        "android-x64": {
          "intent": "link",
          "effective_minimum": "Android API 28"
        }
      }
    },
    "swift": {
      "runtime": "Swift >=6.3",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "ios-arm64": {
          "intent": "link",
          "effective_minimum": "iOS 13.0"
        },
        "ios-sim-arm64": {
          "intent": "runtime",
          "effective_minimum": "iOS 13.0"
        },
        "ios-sim-x64": {
          "intent": "link",
          "effective_minimum": "iOS 13.0"
        }
      }
    },
    "go": {
      "runtime": "Go >=1.27.1; CGO and C compiler",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 13.0"
        },
        "macos-x64": {
          "intent": "runtime",
          "effective_minimum": "macOS 13.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        }
      }
    },
    "c": {
      "runtime": "C11",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        }
      }
    },
    "cpp": {
      "runtime": "C++17",
      "targets": {
        "macos-arm64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "macos-x64": {
          "intent": "runtime",
          "effective_minimum": "macOS 11.0"
        },
        "linux-arm64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        },
        "linux-x64": {
          "intent": "runtime",
          "effective_minimum": "glibc 2.17"
        }
      }
    }
  },
  "node_packages": {
    "macos-arm64": {
      "name": "@arboresce/native-darwin-arm64",
      "binary": "arboresce.darwin-arm64.node"
    },
    "macos-x64": {
      "name": "@arboresce/native-darwin-x64",
      "binary": "arboresce.darwin-x64.node"
    },
    "linux-arm64": {
      "name": "@arboresce/native-linux-arm64-gnu",
      "binary": "arboresce.linux-arm64-gnu.node"
    },
    "linux-x64": {
      "name": "@arboresce/native-linux-x64-gnu",
      "binary": "arboresce.linux-x64-gnu.node"
    }
  },
  "android": {
    "min_sdk": 28,
    "compile_sdk": 36,
    "abis": [
      "arm64-v8a",
      "armeabi-v7a",
      "x86_64"
    ],
    "elf_alignment": 16384
  },
  "apple": {
    "macos": "11.0",
    "ios": "13.0"
  }
}
