{
  "name": "arboresce",
  "version": "0.0.0",
  "description": "TypeScript SDK for Arboresce.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "native/native.cjs",
    "native/native.d.cts",
    "wasm",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test build/test/*.test.js",
    "test:browser": "node --test test/browser/chromium.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arboresce/arboresce-ffi.git"
  },
  "homepage": "https://arboresce.ai",
  "bugs": {
    "url": "https://github.com/arboresce/arboresce-ffi/issues"
  },
  "keywords": [
    "arboresce"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "Tyson Lupul <tyson@arboresce.ai>",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "napi": {
    "binaryName": "arboresce",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ],
    "packageName": "@arboresce/native"
  },
  "optionalDependencies": {
    "@arboresce/native-darwin-arm64": "0.0.0",
    "@arboresce/native-darwin-x64": "0.0.0",
    "@arboresce/native-linux-arm64-gnu": "0.0.0",
    "@arboresce/native-linux-x64-gnu": "0.0.0"
  }
}
