if(NOT TARGET Arboresce::cpp)
    add_library(Arboresce::cpp INTERFACE IMPORTED)
    set_target_properties(Arboresce::cpp PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${ARBORESCE_CPP_INCLUDE_DIR}"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        INTERFACE_LINK_LIBRARIES Arboresce::c_shared)
    add_library(Arboresce::cpp_static INTERFACE IMPORTED)
    set_target_properties(Arboresce::cpp_static PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${ARBORESCE_CPP_INCLUDE_DIR}"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        INTERFACE_LINK_LIBRARIES Arboresce::c_static)
endif()
